IDR_MAINMENU MENU
BEGIN
    POPUP "&Файл"
    BEGIN
        MENUITEM "&Відкрити...\tCtrl+O", IDM_FILE_OPEN
        MENUITEM SEPARATOR
        MENUITEM "Ви&хід", IDM_FILE_EXIT
    END
    POPUP "&Довідка"
    BEGIN
        MENUITEM "&Про програму", IDM_HELP_ABOUT
    END
END